                  "pm.collectionVariables.set('foundReportId', pm.response.json().found.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Match suggestions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports/missing/{{missingReportId}}/matches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reports",
                "missing",
                "{{missingReportId}}",
                "matches"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('suggestion with factors', () => { const s = pm.response.json()[0]; pm.expect(s.score).to.be.at.least(50); pm.expect(s.factors.length).to.eql(5); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm match (desk)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
