              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Postman Family\",\n  \"email\": \"postman.family@test.local\",\n  \"phone\": \"9876501234\",\n  \"password\": \"Password123\",\n  \"role\": \"ADMIN\"\n}"
            }
