              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('MATCHED, no OTP in response', () => { pm.expect(pm.response.json().status).to.eql('MATCHED'); pm.expect(pm.response.text()).to.not.match(/\\d{6}\"/); });"
                ]
              }
            }
