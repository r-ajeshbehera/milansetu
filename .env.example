# Copy to .env and change every value. NEVER commit .env.
DB_USERNAME=milansetu
DB_PASSWORD=change-this-db-password
DB_ROOT_PASSWORD=change-this-root-password
# openssl rand -base64 48
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48
# dev = demo data + simulated inbox; prod = empty database
SPRING_PROFILES_ACTIVE=dev
# mock = simulated delivery (dev) | email = Spring Mail (Mailpit locally, any SMTP in production)
NOTIFICATION_MODE=mock
CORS_ALLOWED_ORIGINS=http://localhost:8082
